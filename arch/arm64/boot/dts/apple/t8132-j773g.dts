/*
 * Apple Mac mini (M4, 2024)
 *
 * target-type: J773g
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";
	chassis-type = "desktop";
};

/*
 * The running PMP firmware accesses the PMC block, so its power state must
 * stay on, as the boot loader leaves it.
 */
&ps_pmc {
	apple,always-on;
};

/*
 * The PMP itself is enabled by the boot loader, which supplies its board
 * and DRAM parameters and tunables. Its report provider owns readiness for
 * shared PMP commands.
 */
&pmp_dart {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp {
	apple,pmp-report = <&pmp_report>;
};

&mcc {
	status = "okay";
	apple,boot-dma-devices = <&pmp>;
};

&pmc {
	status = "okay";
	apple,static-voters = <3>;
};

/*
 * No external display pipe votes through the PMC on this board yet; keep
 * their interface enables out of Linux.
 */
/delete-node/ &pmc_dispext0;
/delete-node/ &pmc_dispext1;

/*
 * Keep the power-domains used for the HDMI port on.
 */
&framebuffer0 {
	power-domains = <&ps_dispext0_fe>, <&ps_dptx_phy>;
};
