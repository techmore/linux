/*
 * Apple Mac mini (M4, 2024)
 *
 * target-type: J773g
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";
	chassis-type = "desktop";

	aliases {
		ans = &nvme;
		ans-mbox = &ans_mbox;
		bluetooth0 = &bluetooth0;
		ethernet0 = &ethernet0;
		gpu = &gpu;
		pmu-primary = &pmic1;
		pmp = &pmp;
		sart-ans = &sart;
		spmi-primary = &nub_spmi;
		wifi0 = &wifi0;
	};

	chosen {
		linux-enablement-mac,disk-boot;
		/* J773g initially hands off only the PMP consumer. */
		linux-enablement-mac,dapf-handoff = "/arm-io/pmp";
		linux-enablement-mac,dapf-power-on-handoff = "/arm-io/pmp";
	};

	/* G16 handoff placeholders; m1n1 fills each range and sets it okay. */
	reserved-memory {
		gpu_ttbs: uat-ttbs {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		gpu_pagetables: uat-pagetables {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		gpu_handoff: uat-handoff {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		gpu_shared_l2: uat-shared-l2 {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		gpu_fw_text: gpu-fw-text {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};

		gpu_fw_data: gpu-fw-data {
			reg = <0 0 0 0>;
			no-map;
			status = "disabled";
		};
	};

	/*
	 * The amp's shutdown line (SDZ, AP GPIO 15: the ADT
	 * /arm-io/i2c3/audio-speaker function-reset; low = shutdown), as on J713.
	 */
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl_ap 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		status = "disabled";
	};

	/*
	 * The J773g ADT routes the speaker and the jack through the AOP audio
	 * service (/arm-io/aop/.../iop-audio-controller: audio-speaker and
	 * audio-codec-output streams), as on J713. Neither the AOP handoff nor
	 * a J773g macaudio variant exists yet, so both cards stay disabled.
	 */
	sound: sound {
		compatible = "apple,j773g-macaudio", "apple,macaudio";
		model = "Mac mini J773g";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		dai-link@0 {
			reg = <0>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_amp>;
			};
		};
	};

	sound_jack: sound-jack {
		compatible = "apple,j773g-macaudio-jack", "apple,macaudio";
		model = "Mac mini J773g Jack";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 4>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};
};

/*
 * Keep the power-domains used for the HDMI port on.
 */
&framebuffer0 {
	power-domains = <&ps_dispext0_fe>, <&ps_dptx_phy>;
};

/*
 * U-Boot arms this watchdog (WD1) for 60 s before Linux starts; apple_wdt
 * takes it over at probe. Measured on J773g 2026-11-03 (watchdog ladder).
 */
&wdt {
	status = "okay";
};

/*
 * serial0 (ttySAC0) is enabled by t8132-jxxx.dtsi. The J773g has no exposed
 * UART pins; the DebugUSB DockChannel console (dockchannel_uart) is enabled
 * by t8132.dtsi.
 */

&smc_mbox {
	status = "okay";
};

&smc {
	status = "okay";

	smc_hwmon: hwmon {
		compatible = "apple,smc-hwmon";
	};

	rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
	};

	reboot {
		compatible = "apple,t8132-smc-reboot", "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			      <&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
				   "boot_error_count", "panic_count";
	};
};

/*
 * The primary PMU (Abbey) is SID 0xe on /arm-io/nub-spmi0 (reg[0] bus
 * 0x188714000). m1n1 rewrites both from the live ADT; these are the J773g
 * 26.6.2 ADT values, so the tree also works without that transfer.
 */
&nub_spmi {
	reg = <0x3 0x88714000 0x0 0x4000>;
	status = "okay";

	pmic1: pmic@e {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

/*
 * Internal SSD. m1n1 rewrites these windows and interrupts from the live
 * ADT /arm-io/ans (and /arm-io/sart-ans) and enables the nodes. The static
 * values are the J773g windows that boot this tree's apple_nvme_t8132_hw
 * (separate NVMMU) from the SSD today: gravity-LS.dtb, 2026-11-04.
 *
 * "nvme" is ADT reg[9] (bus 0x2c5cc0000, phys 0x4c5cc0000) and "nvmmu" is
 * reg[3] (bus 0x285cc0000, phys 0x485cc0000, 0x60000), the split m1n1 uses
 * for every nvme-secure-bar chip. The ADT gives reg[9] only 0x10000; the
 * linear submission registers reach 0x24910, so m1n1 maps 0x40000 and this
 * static tree keeps the 0x60000 that booted.
 *
 * Open: Asahi m1n1 543667fe0cb8 ("nvme: use reg[9] for everything on
 * T8132") maps the NVMMU through reg[9] instead of a separate reg[3]
 * window. That contradicts the separate 0x485cc0000 NVMMU kept here; only
 * a boot with each layout settles which one this driver needs.
 */
&ans_mbox {
	reg = <0x4 0x81608000 0x0 0x4000>;
	interrupts = <AIC_IRQ 1003 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1004 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1005 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1006 IRQ_TYPE_LEVEL_HIGH>;
	status = "okay";
};

&sart {
	reg = <0x4 0x85c50000 0x0 0x10000>;
	status = "okay";
};

&nvme {
	reg = <0x4 0xc5cc0000 0x0 0x60000>,
	      <0x4 0x85cc0000 0x0 0x60000>,
	      <0x4 0x81600000 0x0 0x4000>;
	interrupts = <AIC_IRQ 1018 IRQ_TYPE_LEVEL_HIGH>;
	status = "okay";
};

/*
 * Internal PCIe: three root ports. Port 0 carries the BCM4388 Wi-Fi and
 * Bluetooth module, port 2 the Ethernet controller; the J773g ADT has no
 * pci-bridge1, so port 1 is not wired. The controller node in t8132.dtsi
 * is the one-port J713 description; this board widens it to the three
 * ports, their PHYs and interrupts, as booted on J773g (gravity-LS.dtb).
 */
&pinctrl_ap {
	/* CLKREQ# of ports 0-2 (ADT pci-bridge0/2 function-clkreq: 160, 162). */
	pcie_pins: pcie-pins {
		pinmux = <APPLE_PINMUX(160, 1)>,
			 <APPLE_PINMUX(161, 1)>,
			 <APPLE_PINMUX(162, 1)>;
	};
};

&soc {
	dart_apcie1: iommu@491000000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x4 0x91000000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1236 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_apcie_gp>;
		status = "disabled";
	};

	dart_apcie2: iommu@492000000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x4 0x92000000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1250 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_apcie_gp>;
		status = "okay";
	};
};

/*
 * T8110-style DARTs keep their exception records at +0x4000..+0xc000 and
 * the driver reads them at reset: a 0x4000 window wedges the SoC in the
 * device initcalls (J773g, 2026-11-04). 0xc000 is the window that boots;
 * the ADT describes 0x20000 for dart-apcie0 and dart-apcie2.
 */
&dart_apcie0 {
	reg = <0x4 0x90000000 0x0 0xc000>;
	interrupts = <AIC_IRQ 1232 IRQ_TYPE_LEVEL_HIGH>;
	power-domains = <&ps_apcie_gp>;
	status = "okay";
};

&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x1000000>,
	      <0x4 0x94000000 0x0 0x4000>,
	      <0x4 0x90028000 0x0 0x4000>,
	      <0x4 0x91028000 0x0 0x4000>,
	      <0x4 0x92028000 0x0 0x4000>,
	      <0x4 0x97020000 0x0 0x4000>,
	      <0x4 0x97024000 0x0 0x4000>,
	      <0x4 0x97028000 0x0 0x4000>;
	reg-names = "config", "rc", "port0", "port1", "port2",
		    "phy0", "phy1", "phy2";
	interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1240 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1249 IRQ_TYPE_LEVEL_HIGH>;
	/*
	 * Stream 1 of each port's DART, as booted. The ADT lists SIDs 16-18
	 * for dart-apcie2.
	 */
	iommu-map = <0x100 &dart_apcie0 1 1>,
		    <0x200 &dart_apcie2 1 1>;
	bus-range = <0 3>;
	power-domains = <&ps_apcie_phy_sw>;
	pinctrl-0 = <&pcie_pins>;
	pinctrl-names = "default";
	status = "okay";

	pcie0_port1: pci@1,0 {
		device_type = "pci";
		reg = <0x800 0x0 0x0 0x0 0x0>;
		/* Not in the J773g ADT: from the T8132 port layout, unverified. */
		reset-gpios = <&pinctrl_ap 164 GPIO_ACTIVE_LOW>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie0_port1 0 0 0 0>,
				<0 0 0 2 &pcie0_port1 0 0 0 1>,
				<0 0 0 3 &pcie0_port1 0 0 0 2>,
				<0 0 0 4 &pcie0_port1 0 0 0 3>;
		status = "disabled";
	};

	pcie0_port2: pci@2,0 {
		device_type = "pci";
		reg = <0x1000 0x0 0x0 0x0 0x0>;
		/* ADT pci-bridge2 function-perst: AP GPIO 0xa5. No power enable. */
		reset-gpios = <&pinctrl_ap 165 GPIO_ACTIVE_LOW>;
		bus-range = <2 2>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie0_port2 0 0 0 0>,
				<0 0 0 2 &pcie0_port2 0 0 0 1>,
				<0 0 0 3 &pcie0_port2 0 0 0 2>,
				<0 0 0 4 &pcie0_port2 0 0 0 3>;

		/* AQC113 (ADT lan-1gb) on atlantic. Address filled by m1n1. */
		ethernet0: ethernet@0,0 {
			reg = <0x20000 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};
	};
};

/*
 * Port 0: BCM4388 (ADT pci-bridge0, module-instance "sakhalin"). PERST# is
 * AP GPIO 0xa3 (ADT function-perst); the power enable is SMC GPIO 19, as
 * Wi-Fi and Bluetooth use it under GravityLinux. Neither function has been
 * exercised under this tree's drivers on J773g. m1n1 fills the addresses
 * and the calibration.
 */
&port00 {
	reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;
	pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		brcm,board-type = "apple,sakhalin";
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
	};

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		brcm,board-type = "apple,sakhalin";
		local-bd-address = [00 00 00 00 00 00];
	};
};

/*
 * G16 GPU, PMP, PMC and CLPC, with the J713 structure (t8132-j713-gpu.dtsi).
 * m1n1 fills the six reserved-memory placeholders and the firmware segment
 * layout from the live ADT, and supplies the PMP board/DRAM parameters and
 * tunables before it enables the PMP. The PMP DART gets no apple,dma-range.
 */
&soc {
	gfx_tvm: power-controller@380760800 {
		compatible = "apple,t8132-gfx-tvm";
		reg = <0x3 0x80760800 0x0 0x4>;
		#power-domain-cells = <0>;
	};

	gpu: gpu@302600000 {
		compatible = "apple,agx-t8132";
		reg = <0x3 0x02600000 0x0 0x4000>,
		      <0x3 0x00000000 0x0 0x4000000>;
		reg-names = "asc", "sgx";
		mboxes = <&agx_mbox>;
		power-domains = <&ps_gfx>;
		/* G16 is admitted on non-coherent DMA only. */
		dma-noncoherent;
		apple,pmp = <&pmp>;
		apple,clpc = <&clpc>;
		memory-region = <&gpu_ttbs>, <&gpu_pagetables>, <&gpu_handoff>,
				<&gpu_shared_l2>, <&gpu_fw_text>, <&gpu_fw_data>;
		memory-region-names = "ttbs", "pagetables", "handoff",
				      "shared-l2", "fw-text", "fw-data";
	};

	agx_mbox: mailbox@302608000 {
		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x3 0x02608000 0x0 0x4000>;
		/* Idle ring-service kicks need not wake the system. */
		apple,hold-rx-in-sleep;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 993 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 994 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 995 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 996 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
	};
};

/* The outer TVM gate is the parent of the GFX PMGR domain. */
&ps_gfx {
	status = "okay";
	power-domains = <&gfx_tvm>;
	/* The G16 firmware stays live across suspend-to-idle. */
	apple,sleep-retained;
};

&pmp_dart {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

/* The report provider owns readiness for shared PMP commands. */
&pmp {
	apple,pmp-report = <&pmp_report>;
};

&mcc {
	status = "okay";
	apple,boot-dma-devices = <&pmp>;
};

&pmc {
	status = "okay";
	apple,static-voters = <3>;
};

/*
 * CPU frequency scaling. The CPUs already point at the T8132 OPPs and
 * cluster controllers in t8132.dtsi. Without a board thermal owner the
 * driver holds both clusters at or below P-state 4 (P 1800 / E 1860 MHz).
 */
&cpufreq_e {
	status = "okay";
};

&cpufreq_p {
	status = "okay";
};

/* SMC sensors and the fan every Mac mini has. */
#include "hwmon-common.dtsi"
#include "hwmon-mini.dtsi"

/*
 * USB-PD controller of the back-right USB-C port (ADT /arm-io/nub-spmi-a0
 * hpm3, SID 8). This tree's T8132 binding has no "select" interrupt: the
 * driver polls register selection, and the ADT lists only irq/sleep/wake
 * (63, 69, 71). Kernels that take a select interrupt must use line 65,
 * not 64 (GravityLinux 4cb9998f5882, tested on J773g). Disabled until the
 * port's dwc3/atcphy instance is described for T8132.
 */
&nub_spmi_a0 {
	hpm3: usb-pd@8 {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		interrupts = <63 IRQ_TYPE_EDGE_RISING>,
			     <69 IRQ_TYPE_EDGE_RISING>,
			     <71 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "sleep", "wake";
		wakeup-source;
		status = "disabled";

		typec3: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back-right";
			power-role = "dual";
			data-role = "dual";
		};
	};
};

/*
 * The SN012776 speaker amp (ADT /arm-io/i2c3/audio-speaker at 0x38):
 * interrupt AP GPIO 14, level low; speaker-config rx_slot 0, vsense_slot 0,
 * isense_slot 2. Disabled until the J773g sound card exists.
 */
&i2c3 {
	speaker_amp: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		apple,deferred-shutdown;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";
		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <2>;
		ti,vmon-slot-no = <0>;
		status = "disabled";
	};
};

/*
 * The CS42L84 headphone codec (ADT /arm-io/i2c1/audio-codec-output at
 * 0x4b): reset nub GPIO 17, interrupt AP GPIO 98, level low.
 */
&i2c1 {
	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 98 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
		status = "disabled";
	};
};
