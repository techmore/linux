# J773g native Aurora boots without a module tree: anything the board needs
# at runtime must be built in. Merge onto the J773g test config with
# scripts/kconfig/merge_config.sh.
#
# Rear USB-C port controllers: SN201202x HPMs on nub_spmi_a0 (hpm0/1/3).
# Without them no role, orientation or mux event reaches dwc3-apple or the
# ATC PHYs, so a rear port never sees a device.
CONFIG_TYPEC=y
CONFIG_TYPEC_TPS6598X_CORE=y
CONFIG_TYPEC_SN201202X=y

# Rear USB-C docks: storage and wired Ethernet, built in for the same reason.
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# Secondary CPUs: iBoot leaves the CTXR windows armed on the J773g
# secondaries, and aura publishes the OS window in
# /chosen/aurora,ctxr-exec-window. A confined core can not fetch that
# window at EL1, so without this the secondaries die in init_kernel_el
# on the trip through EL1 ("CPUn: failed in unknown state : 0x0") and
# only the boot CPU comes up. asahi.config has it for the same reason.
CONFIG_ARM64_CTXR_EXECMEM=y
